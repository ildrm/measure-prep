NODE_ENV=production
APP_ENV_FILE=../.env.production
DB_PASSWORD=GENERATE_A_UNIQUE_DATABASE_PASSWORD
DB_ROOT_PASSWORD=GENERATE_A_DIFFERENT_ROOT_PASSWORD
DATABASE_URL=mysql://examsim:URL_ENCODED_DB_PASSWORD@mysql:3306/examsim
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
JWT_REFRESH_SECRET=GENERATE_A_DIFFERENT_32_CHARACTER_SECRET
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
WEB_ORIGIN=https://practice.example.com
APP_PUBLIC_URL=https://practice.example.com
NEXT_PUBLIC_API_URL=https://practice.example.com/api/v1
INTERNAL_API_URL=http://api:3001/api/v1
MINIO_ENDPOINT=minio
MINIO_PUBLIC_ENDPOINT=practice.example.com
MINIO_PORT=443
MINIO_ACCESS_KEY=GENERATE_A_STORAGE_ACCESS_KEY
MINIO_SECRET_KEY=GENERATE_A_STORAGE_SECRET
MINIO_BUCKET=exam-media
MINIO_USE_SSL=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
EMAIL_FROM=Measure <no-reply@example.com>
AI_SCORING_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1
